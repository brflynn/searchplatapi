<Window
    x:Class="SearchApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SearchApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Search">

    <Grid Background="#FF0D0D14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="700"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar drag region -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="3"
                x:Name="AppTitleBar"
                Background="Transparent"/>

        <!-- Centered search box -->
        <TextBox Grid.Row="1"
                 Grid.ColumnSpan="3"
                 x:Name="SearchTextBox"
                 PlaceholderText="Type to search files..."
                 TextChanged="SearchTextBox_TextChanged"
                 KeyDown="SearchTextBox_KeyDown"
                 HorizontalAlignment="Center"
                 Width="680"
                 FontSize="22"
                 Padding="16,12"
                 CornerRadius="8"
                 Margin="0,20,0,0"/>

        <!-- Status bar -->
        <TextBlock Grid.Row="2"
                   Grid.ColumnSpan="3"
                   x:Name="StatusText"
                   HorizontalAlignment="Center"
                   Width="680"
                   Margin="0,10,0,0"
                   FontSize="12"
                   Foreground="#FF7E7E8E"/>

        <!-- Live background-index status -->
        <Border Grid.Row="3"
                Grid.Column="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="250"
                Margin="24,8,20,16"
                Padding="18"
                Background="#CC181821"
                BorderBrush="#FF30303C"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel Spacing="10">
                <TextBlock Text="BACKGROUND INDEX"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#FF7E7E8E"
                           CharacterSpacing="80"/>
                <Border HorizontalAlignment="Left"
                        Padding="8,3"
                        Background="#FF253449"
                        CornerRadius="5">
                    <TextBlock x:Name="IndexerStateText"
                               Text="Starting..."
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FF80BFFF"/>
                </Border>
                <StackPanel Spacing="3">
                    <TextBlock Text="Scanned this run"
                               FontSize="11"
                               Foreground="#FF7E7E8E"/>
                    <TextBlock x:Name="SessionScannedText"
                               Text="0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </StackPanel>
                <StackPanel Spacing="3">
                    <TextBlock Text="Elapsed"
                               FontSize="11"
                               Foreground="#FF7E7E8E"/>
                    <TextBlock x:Name="IndexElapsedText"
                               Text="0s"
                               FontSize="13"
                               Foreground="#FFDDDDDF"/>
                </StackPanel>
                <StackPanel Spacing="3">
                    <TextBlock Text="Current path"
                               FontSize="11"
                               Foreground="#FF7E7E8E"/>
                    <TextBlock x:Name="CurrentIndexPathText"
                               Text="Waiting for scan work..."
                               FontSize="11"
                               Foreground="#FFB5B5BE"
                               TextWrapping="Wrap"
                               MaxLines="4"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Search results -->
        <ListView Grid.Row="3"
                  Grid.Column="1"
                  x:Name="SearchResults"
                  DoubleTapped="SearchResults_DoubleTapped"
                  HorizontalAlignment="Center"
                  Width="700"
                  SelectionMode="Single"
                  Background="Transparent"
                  Margin="0,8,0,16"
                  Padding="10,0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,1"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SearchResultItem">
                    <Grid ColumnSpacing="12" Padding="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Column="0" Grid.RowSpan="2"
                               Source="{x:Bind ItemImage}"
                               Width="24" Height="24"
                               VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Grid.Row="0"
                                   Text="{x:Bind DisplayName}"
                                   FontSize="14"
                                   Foreground="#FFFFFFFF"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Grid.Row="1"
                                   Text="{x:Bind FilePath}"
                                   FontSize="11"
                                   Foreground="#99FFFFFF"
                                   TextTrimming="CharacterEllipsis"/>
                        <!-- Match provenance badge: NAME/META/TEXT per
                             MatchKind, colored via MatchKindBrush -->
                        <Border Grid.Column="2" Grid.RowSpan="2"
                                Background="{x:Bind MatchKindBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind MatchKindLabel}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFFFF"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Persisted index totals -->
        <Border Grid.Row="3"
                Grid.Column="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="250"
                Margin="20,8,24,16"
                Padding="18"
                Background="#CC181821"
                BorderBrush="#FF30303C"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel Spacing="12">
                <TextBlock Text="INDEXED ITEMS"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#FF7E7E8E"
                           CharacterSpacing="80"/>
                <TextBlock x:Name="TotalIndexedItemsText"
                           Text="0"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="White"/>
                <Rectangle Height="1" Fill="#FF30303C"/>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Files" Foreground="#FF9B9BA6"/>
                    <TextBlock Grid.Column="1"
                               x:Name="IndexedFilesText"
                               Text="0"
                               FontWeight="SemiBold"
                               Foreground="#FFE5E5E8"/>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Folders" Foreground="#FF9B9BA6"/>
                    <TextBlock Grid.Column="1"
                               x:Name="IndexedFoldersText"
                               Text="0"
                               FontWeight="SemiBold"
                               Foreground="#FFE5E5E8"/>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Content indexed" Foreground="#FF9B9BA6"/>
                    <TextBlock Grid.Column="1"
                               x:Name="ContentIndexedFilesText"
                               Text="0"
                               FontWeight="SemiBold"
                               Foreground="#FFE5E5E8"/>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Volumes complete" Foreground="#FF9B9BA6"/>
                    <TextBlock Grid.Column="1"
                               x:Name="IndexedVolumesText"
                               Text="0 / 0"
                               FontWeight="SemiBold"
                               Foreground="#FFE5E5E8"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
